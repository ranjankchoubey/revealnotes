{
  "name": "RevealNotes",
  "short_name": "RevealNotes",
  "description": "Present XNotes handwriting step by step.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#121317",
  "theme_color": "#121317",
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "icon.svg", "sizes": "any", "type": "image/svg+xml" }
  ],
  "file_handlers": [
    {
      "action": "./",
      "accept": {
        "application/zip": [".xcanvas", ".xnote"],
        "application/json": [".json"]
      }
    }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "files",
          "accept": [".xcanvas", ".xnote", ".json", "application/zip", "application/json", "application/octet-stream"]
        }
      ]
    }
  }
}
